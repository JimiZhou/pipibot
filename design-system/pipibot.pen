    {
      "id": "scr-mac-manus-cue-pill",
      "name": "macOS Manus Cue Pill",
      "type": "FRAME",
      "platform": "desktop",
      "width": 560,
      "height": 48,
      "cornerRadius": 9999,
      "clip": true,
      "effects": [{ "type": "DROP_SHADOW", "radius": 24 }],
      "fills": [{ "type": "SOLID", "variableId": "tokens.bgElevated", "fallbackColor": "#121418" }],
      "strokes": [{ "type": "SOLID", "variableId": "tokens.borderStrong", "fallbackColor": "#363D4F" }],
      "children": [
        { "id": "cue-ctx", "type": "TEXT", "textStyleId": "ts-mono-xs", "content": "Xcode · PipiHost.swift", "fills": [{ "type": "SOLID", "variableId": "tokens.soulSecondary", "fallbackColor": "#38BDF8" }] },
        { "id": "cue-msg", "type": "TEXT", "textStyleId": "ts-body-sm", "content": "Run SwiftUI regression via Pi + Xcode MCP", "fills": [{ "type": "SOLID", "variableId": "tokens.textPrimary", "fallbackColor": "#F4F5F7" }] },
        {
          "id": "cue-run-btn",
          "type": "FRAME",
          "role": "button",
          "platform": "desktop",
          "height": 32,
          "iconSize": 16,
          "gap": 6,
          "cornerRadius": 9999,
          "clip": false,
