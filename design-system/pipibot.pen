          "iconSize": 16,
          "gap": 6,
          "cornerRadius": 10,
          "clip": false,
          "fills": [{ "type": "SOLID", "variableId": "tokens.soulBtnBg", "fallbackColor": "#6353E8" }],
          "children": [
            { "id": "mmp-btn-icon", "type": "ICON", "size": 16, "strokeWeight": 1.5, "strokes": [{ "type": "SOLID", "variableId": "tokens.btnPrimaryFg", "fallbackColor": "#FFFFFF" }] },
            { "id": "mmp-btn-lbl", "type": "TEXT", "textStyleId": "ts-label-sm", "content": "Dispatch", "fills": [{ "type": "SOLID", "variableId": "tokens.btnPrimaryFg", "fallbackColor": "#FFFFFF" }] }
          ]
