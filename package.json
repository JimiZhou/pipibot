{
  "name": "pipibot",
  "version": "0.1.0-alpha",
  "description": "From Tasks to Outcomes, From Chatbots to a Living Cross-Device AI Manager powered by Pi Core, Multi-Harness BYOK Routing, 120Hz Procedural Avatar, 4-Tier Self-Evolving Memory, and $0/mo Cloudflare Edge.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "JimiZhou & PipiBot Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/JimiZhou/pipibot.git"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preview:design": "python3 -m http.server 8080 --bind 127.0.0.1",
    "check:avatar": "node --check design-system/pipibot-avatar.js",
    "check:workspaces": "npm run check --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run check:avatar && npm run check:workspaces && npm run typecheck"
  },
  "keywords": [
    "ai-agent",
    "outcome-manager",
    "pi-coding-agent",
    "mcp",
    "procedural-svg",
    "cloudflare-workers",
    "macos",
    "ios",
    "local-first",
    "self-evolving-memory"
  ]
}
