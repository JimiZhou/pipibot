{
  "name": "pipibot",
  "version": "0.13.3",
  "description": "Your private AI assistant team on macOS and Linux, connected seamlessly to your phone with end-to-end encryption.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "JimiZhou & PipiBot Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/JimiZhou/pipibot.git"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preview:design": "python3 -m http.server 8080 --bind 127.0.0.1",
    "check:avatar": "node --check design-system/pipibot-avatar.js",
    "check:ios": "node --check apps/ios-web/app.js",
    "audit:design": "node scripts/audit-design-system.mjs",
    "audit:protocol": "node scripts/audit-protocol-parity.mjs",
    "start:daemon": "node --experimental-strip-types packages/daemon/src/cli.ts",
    "pipibot": "node --experimental-strip-types packages/core/src/pipibot-cli.ts",
    "test:core": "node --experimental-strip-types --test packages/core/test/wave1.test.ts packages/core/test/wave2.test.ts packages/core/test/wave3.test.ts packages/core/test/wave4.test.ts packages/core/test/wave5.test.ts packages/core/test/board.test.ts",
    "test:daemon": "node --experimental-strip-types --test packages/daemon/test/daemon.test.ts",
    "test:relay": "node --experimental-strip-types --test packages/relay/test/relay.test.ts",
    "build:apple": "cd apps/apple && swift build",
    "test:apple": "cd apps/apple && swift test",
    "app:mac": "bash scripts/build-mac-app.sh",
    "app:dmg": "bash scripts/build-mac-dmg.sh",
    "app:ios": "bash scripts/build-ios-app.sh",
    "check:workspaces": "npm run check --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run check:avatar && npm run check:ios && npm run audit:design && npm run audit:protocol && npm run check:workspaces && npm run test:core && npm run test:daemon && npm run test:relay && npm run typecheck"
  },
  "keywords": [
    "ai-agent",
    "outcome-manager",
    "pi-coding-agent",
    "mcp",
    "procedural-svg",
    "cloudflare-workers",
    "macos",
    "ios",
    "local-first",
    "self-evolving-memory"
  ]
}
